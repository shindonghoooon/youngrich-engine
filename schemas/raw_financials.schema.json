{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YoungRich Raw Annual Financial History",
  "type": "object",
  "required": ["ticker", "company_name", "currency", "unit_scale", "periods"],
  "properties": {
    "ticker": {"type": "string"},
    "company_name": {"type": "string"},
    "currency": {"type": "string"},
    "unit_scale": {"enum": ["units", "thousands", "millions"]},
    "periods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "fiscal_year", "fiscal_period_end", "revenue", "operating_income", "pretax_income",
          "income_tax_expense", "net_income_consolidated", "cfo", "capex", "cash", "total_debt",
          "total_equity", "diluted_shares", "diluted_eps", "sources"
        ],
        "properties": {
          "fiscal_year": {"type": "integer"},
          "fiscal_period_end": {"type": "string", "format": "date"},
          "revenue": {"type": "number"},
          "operating_income": {"type": "number"},
          "pretax_income": {"type": "number"},
          "income_tax_expense": {"type": "number"},
          "net_income_consolidated": {"type": "number"},
          "net_income_common": {"type": ["number", "null"]},
          "cfo": {"type": "number"},
          "capex": {"type": "number", "minimum": 0},
          "cash": {"type": "number", "minimum": 0},
          "total_debt": {"type": "number", "minimum": 0},
          "total_equity": {"type": "number"},
          "diluted_shares": {"type": "number", "exclusiveMinimum": 0},
          "diluted_eps": {"type": "number"},
          "supplied_ebitda": {"type": ["number", "null"]},
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["type", "reference", "filing_date", "retrieved_at"],
              "properties": {
                "type": {"type": "string"},
                "reference": {"type": "string"},
                "filing_date": {"type": "string", "format": "date"},
                "retrieved_at": {"type": "string", "format": "date-time"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
